# Copy to .env.local for local dev. On Vercel, add these under Project → Settings → Environment Variables.
# Everything is optional: features without keys show a friendly "offline" message instead of breaking.

# Public URL (used for link previews). Vercel sets VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Guestbook, hit counter, rate limits: Upstash Redis (Vercel → Storage / Marketplace → Upstash Redis).
# Either naming works; the Vercel integration usually sets the KV_* pair for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# `ask` command: Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# ASK_DAILY_CAP=300

# `mail` command: Resend (resend.com). Without a verified domain, keep the default MAIL_FROM
# and MAIL_TO must be the email you signed up to Resend with.
RESEND_API_KEY=
# MAIL_TO=dj.bantay@berkeley.edu
# MAIL_FROM=DANIEL_OS <hello@your-domain.com>

# `git log`: optional token raises GitHub's rate limit (no scopes needed for public data)
# GITHUB_TOKEN=
# GITHUB_USERNAME=djbantay

# Guestbook moderation: any long random string
GUESTBOOK_ADMIN_TOKEN=
